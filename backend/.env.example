# Render production variables
MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://your-frontend.vercel.app
NODE_ENV=production

# Optional: use a separate secret for password reset links. Falls back to JWT_SECRET if omitted.
FORGOT_TOKEN_SECRET=

# Gmail app password credentials for OTP and password reset email.
SENDER_EMAIL=
SENDER_PASSWORD=

# Render provides PORT automatically. Use this only for local testing.
PORT=5000

# Backward-compatible local names; do not use these on Render.
DB_URL=
AUTH_SECRET=
DOMAIN=

